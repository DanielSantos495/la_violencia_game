{
  "name": "la-violencia-tomo1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "pnpm run ink:build && pnpm run validate:archivo && vite",
    "build": "pnpm run ink:build && pnpm run validate:archivo --release && pnpm run art:build && pnpm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "validate:archivo": "node tools/validate-archivo.ts",
    "art:build": "node tools/art-build.ts",
    "ink:build": "node tools/ink-build.ts",
    "art:review": "node tools/art-review.ts",
    "art:walk": "node tools/art-walk.ts",
    "art:escena": "node tools/art-escena.ts"
  },
  "dependencies": {
    "inkjs": "2.4.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.0",
    "maxrects-packer": "2.7.3",
    "svgo": "4.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
